{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electron.local/contracts/investigation.schema.json",
  "title": "InvestigationCase",
  "type": "object",
  "required": [
    "id",
    "case_id",
    "consumer_id",
    "risk_score",
    "predicted_cause",
    "priority",
    "status",
    "case_type",
    "raw_risk_score",
    "adjusted_risk_score",
    "outlier_flags",
    "allocation_confidence",
    "attribution_status",
    "recommendation",
    "risk_adjustment_reason"
  ],
  "properties": {
    "id": { "type": "string" },
    "case_id": { "type": "string" },
    "consumer_id": { "type": "string" },
    "anomaly_id": { "type": "string" },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "predicted_cause": { "enum": ["NORMAL", "THEFT_TAMPERING", "METER_MALFUNCTION", "COMMUNICATION_FAILURE", "LEGITIMATE_ABNORMAL_CONSUMPTION", "UNCERTAIN"] },
    "priority": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNCERTAIN"] },
    "status": { "enum": ["OPEN", "AI_FLAGGED", "INSPECTION_PENDING", "UNDER_INVESTIGATION", "CONFIRMED", "DISMISSED", "RESOLVED"] },
    "case_type": { "enum": ["STANDARD", "AGGREGATE_REVIEW"] },
    "raw_risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "adjusted_risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "outlier_flags": { "type": "array", "items": { "type": "string" } },
    "allocation_confidence": { "enum": ["UNKNOWN", "LOW", "MEDIUM", "HIGH"] },
    "attribution_status": { "enum": ["AGGREGATE_ONLY", "SINGLE_BUILDING", "DIRECT_METER", "UNKNOWN"] },
    "recommendation": { "type": "string" },
    "risk_adjustment_reason": { "type": "string" },
    "assigned_to": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "field_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "original_text"],
        "properties": {
          "id": { "type": "string" },
          "source": { "enum": ["TEXT", "VOICE", "CHECKLIST", "SYSTEM"] },
          "original_text": { "type": "string" },
          "normalized_evidence": { "type": "object" },
          "language": { "enum": ["EN", "HI", "OR", "OTHER"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "additionalProperties": false
}
