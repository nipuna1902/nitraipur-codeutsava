{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electron.local/contracts/investigation.schema.json",
  "title": "InvestigationCase",
  "type": "object",
  "required": ["case_id", "consumer_id", "risk_score", "predicted_cause", "priority", "status"],
  "properties": {
    "case_id": { "type": "string" },
    "consumer_id": { "type": "string" },
    "anomaly_id": { "type": "string" },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "predicted_cause": { "enum": ["NORMAL", "THEFT_TAMPERING", "METER_MALFUNCTION", "COMMUNICATION_FAILURE", "LEGITIMATE_ABNORMAL_CONSUMPTION", "UNCERTAIN"] },
    "priority": { "type": "number", "minimum": 0, "maximum": 100 },
    "status": { "enum": ["OPEN", "AI_FLAGGED", "INSPECTION_PENDING", "UNDER_INVESTIGATION", "CONFIRMED", "DISMISSED", "RESOLVED"] },
    "assigned_to": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "field_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "original_text"],
        "properties": {
          "id": { "type": "string" },
          "source": { "enum": ["TEXT", "VOICE", "CHECKLIST", "SYSTEM"] },
          "original_text": { "type": "string" },
          "normalized_evidence": { "type": "object" },
          "language": { "enum": ["EN", "HI", "OR", "OTHER"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "additionalProperties": false
}
