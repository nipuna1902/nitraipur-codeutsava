{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electron.local/contracts/telemetry.schema.json",
  "title": "TelemetryReadingInput",
  "type": "object",
  "required": ["consumer_id", "timestamp", "energy", "communication_status"],
  "properties": {
    "consumer_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "voltage": { "type": "number" },
    "current": { "type": "number" },
    "power": { "type": "number" },
    "energy": { "type": "number" },
    "communication_status": { "enum": ["CONNECTED", "DEGRADED", "DISCONNECTED", "UNKNOWN"] },
    "source": { "enum": ["SIMULATOR", "CSV_UPLOAD", "MQTT_DEVICE_FUTURE"] }
  },
  "additionalProperties": false
}
